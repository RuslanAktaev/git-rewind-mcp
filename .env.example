# Скопируй в .env — он в .gitignore.
# Переменные, заданные в окружении, сильнее значений из файла.

# Обязательно: адрес GitLab.
GITLAB_HOST=https://gitlab.example.com

# Токен с правом read_api. Можно не задавать здесь,
# тогда он читается из ~/.gitlab-token.
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Необязательное, значения по умолчанию:
# OLLAMA_URL=http://127.0.0.1:11434
# EMBED_MODEL=bge-m3
# INDEX_DB=~/.git-rewind/index.db
